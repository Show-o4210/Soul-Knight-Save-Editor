# Personal save files are local inputs, never new source files.
/desktop/输入/*
!/desktop/输入/.gitkeep
/desktop/输出/*
!/desktop/输出/.gitkeep
/desktop/参考/*.data
/desktop/参考/*.xml

# Editor and operating-system files
.DS_Store
Thumbs.db
*.log
